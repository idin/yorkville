# >>> standard ignores, written by the update-gitignore skill: change its templates, not this block
# Plans, briefs and concept notes for agents working on this repo. Never published.
.documents/

# Credentials never live in a repo.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
api_keys.json
service_account*.json
client_secret*.json

